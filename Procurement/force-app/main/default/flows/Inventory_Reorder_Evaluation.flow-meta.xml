<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>Evaluates inventory levels and updates Reorder_Status__c before save.</description>
    <environments>Default</environments>
    <interviewLabel>Inventory Reorder Evaluation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Inventory Reorder Evaluation</label>

    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>

    <processType>AutoLaunchedFlow</processType>

    <start>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Decide_Reorder_Status</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>On_Hand__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Reserved__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Reorder_Point__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Inventory__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>

    <status>Active</status>

    <formulas>
        <name>frmAvailable</name>
        <dataType>Number</dataType>
        <expression>IF(ISNULL({!$Record.On_Hand__c}), 0, {!$Record.On_Hand__c}) - IF(ISNULL({!$Record.Reserved__c}), 0, {!$Record.Reserved__c})</expression>
        <scale>2</scale>
    </formulas>

    <formulas>
        <name>frmReorderPt</name>
        <dataType>Number</dataType>
        <expression>IF(ISNULL({!$Record.Reorder_Point__c}), 0, {!$Record.Reorder_Point__c})</expression>
        <scale>2</scale>
    </formulas>

    <formulas>
        <name>frmAtRiskThreshold</name>
        <dataType>Number</dataType>
        <expression>IF(ISNULL({!$Record.Reorder_Point__c}), 0, {!$Record.Reorder_Point__c}) * 1.5</expression>
        <scale>2</scale>
    </formulas>

    <decisions>
        <name>Decide_Reorder_Status</name>
        <label>Decide Reorder Status</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <defaultConnector>
            <targetReference>Set_Healthy</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Healthy</defaultConnectorLabel>

        <rules>
            <name>Is_Reorder_Needed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>frmAvailable</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Reorder_Needed</targetReference>
            </connector>
            <label>Reorder Needed (zero or negative stock)</label>
        </rules>

        <rules>
            <name>Below_Reorder_Point</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>frmAvailable</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>frmReorderPt</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Reorder_Needed2</targetReference>
            </connector>
            <label>At or Below Reorder Point</label>
        </rules>

        <rules>
            <name>Is_At_Risk</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>frmAvailable</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>frmAtRiskThreshold</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_At_Risk</targetReference>
            </connector>
            <label>At Risk (below 1.5x reorder point)</label>
        </rules>
    </decisions>

    <assignments>
        <name>Set_Reorder_Needed</name>
        <label>Set Reorder Needed</label>
        <locationX>0</locationX>
        <locationY>278</locationY>
        <assignmentItems>
            <assignToReference>$Record.Reorder_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Reorder Needed</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Last_Reorder_Run__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
    </assignments>

    <assignments>
        <name>Set_Reorder_Needed2</name>
        <label>Set Reorder Needed (at point)</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <assignmentItems>
            <assignToReference>$Record.Reorder_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Reorder Needed</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Last_Reorder_Run__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
    </assignments>

    <assignments>
        <name>Set_At_Risk</name>
        <label>Set At Risk</label>
        <locationX>352</locationX>
        <locationY>278</locationY>
        <assignmentItems>
            <assignToReference>$Record.Reorder_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>At Risk</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Last_Reorder_Run__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
    </assignments>

    <assignments>
        <name>Set_Healthy</name>
        <label>Set Healthy</label>
        <locationX>528</locationX>
        <locationY>278</locationY>
        <assignmentItems>
            <assignToReference>$Record.Reorder_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Healthy</stringValue>
            </value>
        </assignmentItems>
    </assignments>
</Flow>
