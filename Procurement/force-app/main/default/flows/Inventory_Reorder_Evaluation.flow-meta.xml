<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>After-save flow that re-evaluates reorder status when stock levels or the reorder point change. The authoritative calculation runs in InventoryService (the same classifier used by the Inventory Overview LWC); the flow alerts the warehouse manager when an item newly needs reordering. Recursion is prevented because the Apex action only writes Reorder_Status__c and Last_Reorder_Run__c, which are not entry criteria, and only when the status actually changes.</description>
    <environments>Default</environments>
    <interviewLabel>Inventory Reorder Evaluation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Inventory Reorder Evaluation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <actionCalls>
        <name>Evaluate_Reorder_Status</name>
        <description>Authoritative reorder classification and status update in Apex.</description>
        <label>Evaluate Reorder Status</label>
        <locationX>176</locationX>
        <locationY>150</locationY>
        <actionName>InventoryService</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Needs_Alert</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Capture_Fault</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>inventoryId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <assignments>
        <name>Capture_Fault</name>
        <description>Reorder evaluation is advisory, so a failure must not block the stock update that triggered it.</description>
        <label>Capture Fault</label>
        <locationX>1076</locationX>
        <locationY>150</locationY>
        <assignmentItems>
            <assignToReference>faultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Needs_Alert</name>
        <label>Alert Warehouse Manager?</label>
        <locationX>476</locationX>
        <locationY>150</locationY>
        <defaultConnectorLabel>No Alert Needed</defaultConnectorLabel>
        <rules>
            <name>Newly_Reorder_Needed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Evaluate_Reorder_Status.newlyReorderNeeded</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Evaluate_Reorder_Status.notifyUserId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Notify_Warehouse_Manager</targetReference>
            </connector>
            <label>Newly Reorder Needed</label>
        </rules>
    </decisions>
    <formulas>
        <name>frmAlertTitle</name>
        <dataType>String</dataType>
        <expression>"Reorder needed: " &amp; IF(ISBLANK({!$Record.Product__r.Name}), {!$Record.Name}, {!$Record.Product__r.Name})</expression>
    </formulas>
    <formulas>
        <name>frmAlertMessage</name>
        <dataType>String</dataType>
        <expression>"Stock for " &amp; IF(ISBLANK({!$Record.Product__r.Name}), {!$Record.Name}, {!$Record.Product__r.Name}) &amp; " has fallen to or below the reorder point. Raise a requisition to replenish it."</expression>
    </formulas>
    <subflows>
        <name>Notify_Warehouse_Manager</name>
        <label>Notify Warehouse Manager</label>
        <locationX>776</locationX>
        <locationY>150</locationY>
        <flowName>Procurement_Subflow_Notify</flowName>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>recipientId</name>
            <value>
                <elementReference>Evaluate_Reorder_Status.notifyUserId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>title</name>
            <value>
                <elementReference>frmAlertTitle</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>message</name>
            <value>
                <elementReference>frmAlertMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>createTask</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>taskDueInDays</name>
            <value>
                <numberValue>2.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>dedupeDays</name>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <name>faultMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Evaluate_Reorder_Status</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>false</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>OR(ISNEW(), ISCHANGED({!$Record.On_Hand__c}), ISCHANGED({!$Record.Reserved__c}), ISCHANGED({!$Record.Reorder_Point__c}))</filterFormula>
        <filterLogic>formula_evaluates_to_true</filterLogic>
        <object>Inventory__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
