<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>After-save flow that completes the Requisition_Approval approval process (Procurement Approvers queue, field updates set Under Review / Approved / Rejected). When the requisition is approved or rejected it notifies the requester, and on rejection records a reason pointing to the approval history.</description>
    <environments>Default</environments>
    <interviewLabel>Requisition Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Requisition Approval</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <assignments>
        <name>Capture_Fault</name>
        <label>Capture Fault</label>
        <locationX>476</locationX>
        <locationY>300</locationY>
        <assignmentItems>
            <assignToReference>faultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Notify_Requester_Rejected</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Route_Outcome</name>
        <label>Route Outcome</label>
        <locationX>176</locationX>
        <locationY>150</locationY>
        <defaultConnector>
            <targetReference>Reason_Blank</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Rejected</defaultConnectorLabel>
        <rules>
            <name>Was_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Notify_Requester_Approved</targetReference>
            </connector>
            <label>Approved</label>
        </rules>
    </decisions>
    <decisions>
        <name>Reason_Blank</name>
        <label>Rejection Reason Blank?</label>
        <locationX>776</locationX>
        <locationY>150</locationY>
        <defaultConnector>
            <targetReference>Notify_Requester_Rejected</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Reason Provided</defaultConnectorLabel>
        <rules>
            <name>Needs_Reason</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Rejection_Reason__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Rejection_Reason</targetReference>
            </connector>
            <label>Blank</label>
        </rules>
    </decisions>
    <formulas>
        <name>frmRequesterId</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.Requester__c}), {!$Record.OwnerId}, {!$Record.Requester__c})</expression>
    </formulas>
    <formulas>
        <name>frmApprovedMessage</name>
        <dataType>String</dataType>
        <expression>"Requisition " &amp; {!$Record.Name} &amp; " was approved."</expression>
    </formulas>
    <formulas>
        <name>frmRejectedMessage</name>
        <dataType>String</dataType>
        <expression>"Requisition " &amp; {!$Record.Name} &amp; " was rejected. Open the approval history on the record for the approver comments, correct the requisition and resubmit it."</expression>
    </formulas>
    <recordUpdates>
        <name>Set_Rejection_Reason</name>
        <label>Set Rejection Reason</label>
        <locationX>1076</locationX>
        <locationY>150</locationY>
        <connector>
            <targetReference>Notify_Requester_Rejected</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Capture_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Rejection_Reason__c</field>
            <value>
                <stringValue>Rejected by approver. See the approval history for comments.</stringValue>
            </value>
        </inputAssignments>
        <object>Purchase_Requisition__c</object>
    </recordUpdates>
    <subflows>
        <name>Notify_Requester_Approved</name>
        <label>Notify Requester - Approved</label>
        <locationX>476</locationX>
        <locationY>150</locationY>
        <flowName>Procurement_Subflow_Notify</flowName>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>recipientId</name>
            <value>
                <elementReference>frmRequesterId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>title</name>
            <value>
                <stringValue>Requisition approved</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>message</name>
            <value>
                <elementReference>frmApprovedMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>createTask</name>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>Notify_Requester_Rejected</name>
        <label>Notify Requester - Rejected</label>
        <locationX>176</locationX>
        <locationY>300</locationY>
        <flowName>Procurement_Subflow_Notify</flowName>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>recipientId</name>
            <value>
                <elementReference>frmRequesterId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>title</name>
            <value>
                <stringValue>Requisition rejected</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>message</name>
            <value>
                <elementReference>frmRejectedMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>createTask</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>taskDueInDays</name>
            <value>
                <numberValue>3.0</numberValue>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <name>faultMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Route_Outcome</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Rejected</stringValue>
            </value>
        </filters>
        <object>Purchase_Requisition__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
