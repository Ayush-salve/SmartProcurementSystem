<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>Scheduled weekly. SupplierPerformanceService returns the latest Supplier_Scorecard__c of every supplier that is stale (period ended 90+ days ago), High risk or scoring below 60, excluding suppliers that already have a review task created in the last 30 days or still open. The flow creates one review task per supplier in a single DML and sends the Procurement Managers one summary notification.</description>
    <environments>Default</environments>
    <interviewLabel>Supplier Review Request {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Supplier Review Request</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <actionCalls>
        <name>Find_Due_Suppliers</name>
        <description>Bulk query in Apex; already excludes suppliers with an open or recent review task.</description>
        <label>Find Due Suppliers</label>
        <locationX>176</locationX>
        <locationY>150</locationY>
        <actionName>SupplierPerformanceService</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Any_Due</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Capture_Fault</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>reviewIntervalDays</name>
            <value>
                <numberValue>90.0</numberValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>minimumScore</name>
            <value>
                <numberValue>60.0</numberValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>taskSubjectPrefix</name>
            <value>
                <stringValue>Supplier review due</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>dedupeDays</name>
            <value>
                <numberValue>30.0</numberValue>
            </value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <assignments>
        <name>Build_Review_Task</name>
        <label>Build Review Task</label>
        <locationX>1076</locationX>
        <locationY>150</locationY>
        <assignmentItems>
            <assignToReference>varTask.Subject</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>frmTaskSubject</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.Description</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>frmTaskDescription</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.WhatId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Due_Scorecards.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Due_Scorecards.OwnerId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.ActivityDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>frmTaskDueDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTasks</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varTask</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varLastScorecardId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Due_Scorecards.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Due_Scorecards</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Capture_Fault</name>
        <label>Capture Fault</label>
        <locationX>176</locationX>
        <locationY>450</locationY>
        <assignmentItems>
            <assignToReference>faultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Any_Due</name>
        <label>Any Suppliers Due?</label>
        <locationX>476</locationX>
        <locationY>150</locationY>
        <defaultConnectorLabel>None Due</defaultConnectorLabel>
        <rules>
            <name>Has_Due</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Find_Due_Suppliers.dueCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Due_Scorecards</targetReference>
            </connector>
            <label>Suppliers Due</label>
        </rules>
    </decisions>
    <decisions>
        <name>Managers_Queue_Found</name>
        <label>Managers Queue Found?</label>
        <locationX>776</locationX>
        <locationY>300</locationY>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Has_Queue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Managers_Queue</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Notify_Managers</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <formulas>
        <name>frmTaskSubject</name>
        <dataType>String</dataType>
        <expression>"Supplier review due: " &amp; IF(ISBLANK({!Loop_Due_Scorecards.Supplier__r.Name}), {!Loop_Due_Scorecards.Name}, {!Loop_Due_Scorecards.Supplier__r.Name})</expression>
    </formulas>
    <formulas>
        <name>frmTaskDescription</name>
        <dataType>String</dataType>
        <expression>"Review supplier performance. Latest scorecard " &amp; {!Loop_Due_Scorecards.Name} &amp; ": risk " &amp; IF(ISBLANK(TEXT({!Loop_Due_Scorecards.Risk_Level__c})), "n/a", TEXT({!Loop_Due_Scorecards.Risk_Level__c})) &amp; ", overall score " &amp; IF(ISBLANK({!Loop_Due_Scorecards.Overall_Score__c}), "n/a", TEXT({!Loop_Due_Scorecards.Overall_Score__c})) &amp; "."</expression>
    </formulas>
    <formulas>
        <name>frmTaskDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 7</expression>
    </formulas>
    <formulas>
        <name>frmSummaryMessage</name>
        <dataType>String</dataType>
        <expression>TEXT({!Find_Due_Suppliers.dueCount}) &amp; " supplier(s) are due for a performance review. Review tasks were created and assigned to the scorecard owners."</expression>
    </formulas>
    <loops>
        <name>Loop_Due_Scorecards</name>
        <label>Loop Due Scorecards</label>
        <locationX>776</locationX>
        <locationY>150</locationY>
        <collectionReference>Find_Due_Suppliers.dueScorecards</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Build_Review_Task</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_Review_Tasks</targetReference>
        </noMoreValuesConnector>
    </loops>
    <recordCreates>
        <name>Create_Review_Tasks</name>
        <description>Single DML for all review tasks.</description>
        <label>Create Review Tasks</label>
        <locationX>176</locationX>
        <locationY>300</locationY>
        <connector>
            <targetReference>Get_Managers_Queue</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Capture_Fault</targetReference>
        </faultConnector>
        <inputReference>varTasks</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Managers_Queue</name>
        <label>Get Managers Queue</label>
        <locationX>476</locationX>
        <locationY>300</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Managers_Queue_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Capture_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Procurement_Managers</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <subflows>
        <name>Notify_Managers</name>
        <label>Notify Procurement Managers</label>
        <locationX>1076</locationX>
        <locationY>300</locationY>
        <flowName>Procurement_Subflow_Notify</flowName>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>varLastScorecardId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>recipientId</name>
            <value>
                <elementReference>Get_Managers_Queue.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>title</name>
            <value>
                <stringValue>Supplier reviews due</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>message</name>
            <value>
                <elementReference>frmSummaryMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>createTask</name>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <name>varTask</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Task</objectType>
    </variables>
    <variables>
        <name>varTasks</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Task</objectType>
    </variables>
    <variables>
        <name>faultMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varLastScorecardId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Find_Due_Suppliers</targetReference>
        </connector>
        <schedule>
            <frequency>Weekly</frequency>
            <startDate>2026-11-09</startDate>
            <startTime>06:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
