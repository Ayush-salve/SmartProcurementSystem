<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>Scheduled daily. Finds purchase orders in Sent, Acknowledged or Partially Received status whose expected delivery date has passed and that still have outstanding (not Complete / Cancelled) lines, notifies the buyer (record owner) and creates a follow-up task. Duplicate alerts are suppressed for 7 days by the notification subflow.</description>
    <environments>Default</environments>
    <interviewLabel>Delayed Order Alert {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Delayed Order Alert</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <assignments>
        <name>Capture_Fault</name>
        <description>A failed lookup skips this order for today; the next scheduled run retries it.</description>
        <label>Capture Fault</label>
        <locationX>176</locationX>
        <locationY>300</locationY>
        <assignmentItems>
            <assignToReference>faultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Is_Overdue</name>
        <label>Is Overdue?</label>
        <locationX>176</locationX>
        <locationY>150</locationY>
        <defaultConnectorLabel>Not Overdue</defaultConnectorLabel>
        <rules>
            <name>Past_Expected_Delivery</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Expected_Delivery__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Expected_Delivery__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Outstanding_Line</targetReference>
            </connector>
            <label>Past Expected Delivery</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Outstanding</name>
        <label>Has Outstanding Lines?</label>
        <locationX>776</locationX>
        <locationY>150</locationY>
        <defaultConnectorLabel>Fully Received</defaultConnectorLabel>
        <rules>
            <name>Outstanding</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Outstanding_Line</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Notify_Buyer</targetReference>
            </connector>
            <label>Outstanding</label>
        </rules>
    </decisions>
    <formulas>
        <name>frmAlertTitle</name>
        <dataType>String</dataType>
        <expression>"Delayed purchase order: " &amp; {!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>frmAlertMessage</name>
        <dataType>String</dataType>
        <expression>"Purchase order " &amp; {!$Record.Name} &amp; " was expected on " &amp; TEXT({!$Record.Expected_Delivery__c}) &amp; " and still has outstanding quantities. Follow up with the supplier."</expression>
    </formulas>
    <recordLookups>
        <name>Get_Outstanding_Line</name>
        <description>Existence check for outstanding quantities; cancelled and fully received lines are excluded.</description>
        <label>Get Outstanding Line</label>
        <locationX>476</locationX>
        <locationY>150</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Outstanding</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Capture_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Purchase_Order__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Line_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Complete</stringValue>
            </value>
        </filters>
        <filters>
            <field>Line_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Purchase_Order_Line__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <subflows>
        <name>Notify_Buyer</name>
        <label>Notify Buyer</label>
        <locationX>1076</locationX>
        <locationY>150</locationY>
        <flowName>Procurement_Subflow_Notify</flowName>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>recipientId</name>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>title</name>
            <value>
                <elementReference>frmAlertTitle</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>message</name>
            <value>
                <elementReference>frmAlertMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>createTask</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>taskDueInDays</name>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>dedupeDays</name>
            <value>
                <numberValue>7.0</numberValue>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <name>faultMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Overdue</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Draft</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Pending Approval</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Received</stringValue>
            </value>
        </filters>
        <object>Purchase_Order__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-11-09</startDate>
            <startTime>07:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
