<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>Reusable notification subflow. Sends an in-app/mobile custom notification (Procurement Alert) to a user, group or queue and optionally creates a follow-up task. Can skip itself when an identical task was already created recently, which prevents duplicate alerts.</description>
    <environments>Default</environments>
    <interviewLabel>Procurement Subflow Notify {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Procurement Subflow Notify</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <actionCalls>
        <name>Send_Custom_Notification</name>
        <label>Send Custom Notification</label>
        <locationX>1076</locationX>
        <locationY>450</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <connector>
            <targetReference>Set_Notification_Sent</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Notify_Error</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value>
                <elementReference>Get_Notification_Type.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value>
                <elementReference>recipientIds</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value>
                <elementReference>title</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value>
                <elementReference>message</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>targetId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
    <assignments>
        <name>Set_Input_Error</name>
        <label>Set Input Error</label>
        <locationX>476</locationX>
        <locationY>150</locationY>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>A recipient and a title are required.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Skipped</name>
        <label>Set Skipped as Duplicate</label>
        <locationX>476</locationX>
        <locationY>300</locationY>
        <assignmentItems>
            <assignToReference>skippedAsDuplicate</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Type_Error</name>
        <label>Set Notification Type Error</label>
        <locationX>1076</locationX>
        <locationY>300</locationY>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Should_Create_Task</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Type_Missing</name>
        <label>Set Notification Type Missing</label>
        <locationX>476</locationX>
        <locationY>450</locationY>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Custom notification type Procurement_Alert was not found.</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Should_Create_Task</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Build_Recipients</name>
        <label>Build Recipient List</label>
        <locationX>776</locationX>
        <locationY>450</locationY>
        <assignmentItems>
            <assignToReference>recipientIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>recipientId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Send_Custom_Notification</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Notification_Sent</name>
        <label>Set Notification Sent</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <assignmentItems>
            <assignToReference>notificationSent</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Should_Create_Task</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Notify_Error</name>
        <label>Set Notification Error</label>
        <locationX>476</locationX>
        <locationY>600</locationY>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Should_Create_Task</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Build_Task</name>
        <label>Build Follow-Up Task</label>
        <locationX>1076</locationX>
        <locationY>600</locationY>
        <assignmentItems>
            <assignToReference>varNewTask.Subject</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>title</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewTask.Description</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>message</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewTask.WhatId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewTask.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>frmTaskOwner</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewTask.ActivityDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>frmTaskDueDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewTask.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewTask.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Follow_Up_Task</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Task_Created</name>
        <label>Set Task Created</label>
        <locationX>476</locationX>
        <locationY>750</locationY>
        <assignmentItems>
            <assignToReference>taskCreated</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Task_Error</name>
        <label>Set Task Error</label>
        <locationX>776</locationX>
        <locationY>750</locationY>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Validate_Inputs</name>
        <description>Both a recipient and a title are required.</description>
        <label>Validate Inputs</label>
        <locationX>176</locationX>
        <locationY>150</locationY>
        <defaultConnector>
            <targetReference>Dedupe_Enabled</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Inputs Valid</defaultConnectorLabel>
        <rules>
            <name>Inputs_Missing</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>recipientId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>title</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Input_Error</targetReference>
            </connector>
            <label>Recipient or Title Missing</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dedupe_Enabled</name>
        <label>Duplicate Check Enabled?</label>
        <locationX>776</locationX>
        <locationY>150</locationY>
        <defaultConnector>
            <targetReference>Get_Notification_Type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Duplicate Check</defaultConnectorLabel>
        <rules>
            <name>Check_Duplicates</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>dedupeDays</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_Task</targetReference>
            </connector>
            <label>Check for Duplicates</label>
        </rules>
    </decisions>
    <decisions>
        <name>Duplicate_Found</name>
        <label>Duplicate Found?</label>
        <locationX>176</locationX>
        <locationY>300</locationY>
        <defaultConnector>
            <targetReference>Get_Notification_Type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not a Duplicate</defaultConnectorLabel>
        <rules>
            <name>Is_Duplicate</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Task</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Skipped</targetReference>
            </connector>
            <label>Duplicate</label>
        </rules>
    </decisions>
    <decisions>
        <name>Notification_Type_Found</name>
        <label>Notification Type Found?</label>
        <locationX>176</locationX>
        <locationY>450</locationY>
        <defaultConnector>
            <targetReference>Set_Type_Missing</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Type_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Notification_Type</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Build_Recipients</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Should_Create_Task</name>
        <label>Should Create Task?</label>
        <locationX>776</locationX>
        <locationY>600</locationY>
        <defaultConnectorLabel>No Task</defaultConnectorLabel>
        <rules>
            <name>Task_Required</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>createTask</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Build_Task</targetReference>
            </connector>
            <label>Create Task</label>
        </rules>
    </decisions>
    <formulas>
        <name>frmDedupeCutoff</name>
        <description>Earliest creation time that still counts as a duplicate.</description>
        <dataType>DateTime</dataType>
        <expression>NOW() - {!dedupeDays}</expression>
    </formulas>
    <formulas>
        <name>frmTaskOwner</name>
        <description>Tasks must be owned by a user, so group or queue recipients fall back to the running user.</description>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!taskOwnerId})), {!taskOwnerId}, IF(LEFT({!recipientId}, 3) = "005", {!recipientId}, {!$User.Id}))</expression>
    </formulas>
    <formulas>
        <name>frmTaskDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + {!taskDueInDays}</expression>
    </formulas>
    <recordCreates>
        <name>Create_Follow_Up_Task</name>
        <label>Create Follow-Up Task</label>
        <locationX>176</locationX>
        <locationY>750</locationY>
        <connector>
            <targetReference>Set_Task_Created</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Task_Error</targetReference>
        </faultConnector>
        <inputReference>varNewTask</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Existing_Task</name>
        <description>A matching task created within the dedupe window means this alert was already raised.</description>
        <label>Get Existing Task</label>
        <locationX>1076</locationX>
        <locationY>150</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Duplicate_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Get_Notification_Type</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>WhatId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Subject</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>title</elementReference>
            </value>
        </filters>
        <filters>
            <field>CreatedDate</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>frmDedupeCutoff</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Notification_Type</name>
        <label>Get Notification Type</label>
        <locationX>776</locationX>
        <locationY>300</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Notification_Type_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Type_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Procurement_Alert</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CustomNotificationType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <variables>
        <name>recordId</name>
        <description>Id of the record the notification and task relate to.</description>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>recipientId</name>
        <description>User, public group or queue Id that receives the notification.</description>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>title</name>
        <description>Notification title. Also used as the task subject and duplicate key.</description>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>message</name>
        <description>Notification body. Also used as the task description.</description>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>createTask</name>
        <description>Create a follow-up task when true.</description>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <name>taskOwnerId</name>
        <description>Optional task owner (user Id). Defaults to the recipient when the recipient is a user, otherwise the running user.</description>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>taskDueInDays</name>
        <description>Days from today until the task is due.</description>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
        <value>
            <numberValue>2.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>dedupeDays</name>
        <description>When greater than zero, skip everything if a task with the same subject already exists on the record within this many days.</description>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>notificationSent</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>taskCreated</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>skippedAsDuplicate</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>errorMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>recipientIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varNewTask</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Task</objectType>
    </variables>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Validate_Inputs</targetReference>
        </connector>
    </start>
    <status>Active</status>
</Flow>
