<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>Reusable subflow for creating tasks and sending notifications in the procurement process.</description>
    <environments>Default</environments>
    <interviewLabel>Procurement Subflow Notify {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Procurement Subflow Notify</label>

    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>

    <processType>AutoLaunchedFlow</processType>

    <start>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Should_Create_Task</targetReference>
        </connector>
    </start>

    <status>Active</status>

    <variables>
        <name>taskSubject</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>

    <variables>
        <name>taskOwnerId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>

    <variables>
        <name>relatedToId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>

    <variables>
        <name>taskDescription</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>

    <variables>
        <name>createTask</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>true</booleanValue>
        </value>
    </variables>

    <variables>
        <name>varNewTask</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Task</objectType>
    </variables>

    <decisions>
        <name>Should_Create_Task</name>
        <label>Should Create Task?</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <defaultConnectorLabel>No Task</defaultConnectorLabel>

        <rules>
            <name>Yes_Create_Task</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>createTask</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>taskSubject</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Build_Task</targetReference>
            </connector>
            <label>Yes, Create Task</label>
        </rules>
    </decisions>

    <assignments>
        <name>Build_Task</name>
        <label>Build Task Record</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <connector>
            <targetReference>Create_Task_Record</targetReference>
        </connector>

        <assignmentItems>
            <assignToReference>varNewTask.Subject</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>taskSubject</elementReference>
            </value>
        </assignmentItems>

        <assignmentItems>
            <assignToReference>varNewTask.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>taskOwnerId</elementReference>
            </value>
        </assignmentItems>

        <assignmentItems>
            <assignToReference>varNewTask.WhatId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>relatedToId</elementReference>
            </value>
        </assignmentItems>

        <assignmentItems>
            <assignToReference>varNewTask.Description</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>taskDescription</elementReference>
            </value>
        </assignmentItems>

        <assignmentItems>
            <assignToReference>varNewTask.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </assignmentItems>

        <assignmentItems>
            <assignToReference>varNewTask.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </assignmentItems>
    </assignments>

    <recordCreates>
        <name>Create_Task_Record</name>
        <label>Create Task Record</label>
        <locationX>176</locationX>
        <locationY>398</locationY>
        <inputReference>varNewTask</inputReference>
    </recordCreates>
</Flow>
