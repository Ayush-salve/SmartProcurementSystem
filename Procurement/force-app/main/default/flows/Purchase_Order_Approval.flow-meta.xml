<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>After-save flow that routes purchase orders for approval by amount. When Status becomes Pending Approval it validates the order and recalculates its total in PurchaseOrderService, finds the matching band in Approval_Threshold__mdt (highest Min_Amount__c not above the total), submits the order to the approval process named in that record and notifies the configured group. Threshold amounts, approval process and notification group all live in Custom Metadata. When the order is approved or returned to Draft the buyer is notified.</description>
    <environments>Default</environments>
    <interviewLabel>Purchase Order Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Purchase Order Approval</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <actionCalls>
        <name>Prepare_Order</name>
        <description>Validates supplier and lines and recalculates the subtotal so routing uses an authoritative amount.</description>
        <label>Validate Order And Calculate Total</label>
        <locationX>476</locationX>
        <locationY>150</locationY>
        <actionName>PurchaseOrderService</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Order_Valid</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Block_On_Fault</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>purchaseOrderId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>operation</name>
            <value>
                <stringValue>PREPARE_APPROVAL</stringValue>
            </value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <actionCalls>
        <name>Submit_For_Approval</name>
        <label>Submit For Approval</label>
        <locationX>476</locationX>
        <locationY>450</locationY>
        <actionName>submit</actionName>
        <actionType>submit</actionType>
        <connector>
            <targetReference>Get_Notification_Queue</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Block_Approval_Fault</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>objectId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>processDefinitionNameOrId</name>
            <value>
                <elementReference>Get_Approval_Threshold.Approval_Process__c</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>skipEntryCriteria</name>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputParameters>
    </actionCalls>
    <assignments>
        <name>Capture_Fault</name>
        <description>Approver notification is best-effort; the approval request itself was already created.</description>
        <label>Capture Fault</label>
        <locationX>776</locationX>
        <locationY>600</locationY>
        <assignmentItems>
            <assignToReference>faultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <customErrors>
        <name>Block_Invalid_Order</name>
        <label>Block Invalid Order</label>
        <locationX>1076</locationX>
        <locationY>150</locationY>
        <customErrorMessages>
            <errorMessage>{!Prepare_Order.message}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Block_On_Fault</name>
        <label>Block On Fault</label>
        <locationX>176</locationX>
        <locationY>300</locationY>
        <customErrorMessages>
            <errorMessage>The purchase order could not be validated: {!$Flow.FaultMessage}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Block_Threshold_Fault</name>
        <label>Block Threshold Fault</label>
        <locationX>776</locationX>
        <locationY>300</locationY>
        <customErrorMessages>
            <errorMessage>Approval thresholds could not be read: {!$Flow.FaultMessage}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Block_No_Threshold</name>
        <label>Block No Threshold</label>
        <locationX>176</locationX>
        <locationY>450</locationY>
        <customErrorMessages>
            <errorMessage>No approval threshold is configured for this order amount. Add an Approval Threshold custom metadata record.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Block_Approval_Fault</name>
        <label>Block Approval Fault</label>
        <locationX>776</locationX>
        <locationY>450</locationY>
        <customErrorMessages>
            <errorMessage>Approval could not be started: {!$Flow.FaultMessage}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Route_By_Status</name>
        <label>Route By Status</label>
        <locationX>176</locationX>
        <locationY>150</locationY>
        <defaultConnectorLabel>Not An Approval Transition</defaultConnectorLabel>
        <rules>
            <name>Submitted_For_Approval</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending Approval</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Prepare_Order</targetReference>
            </connector>
            <label>Submitted For Approval</label>
        </rules>
        <rules>
            <name>Approval_Granted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending Approval</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Notify_Buyer_Approved</targetReference>
            </connector>
            <label>Approval Granted</label>
        </rules>
        <rules>
            <name>Returned_To_Draft</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Draft</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending Approval</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Notify_Buyer_Returned</targetReference>
            </connector>
            <label>Rejected Or Recalled</label>
        </rules>
    </decisions>
    <decisions>
        <name>Order_Valid</name>
        <label>Order Valid?</label>
        <locationX>776</locationX>
        <locationY>150</locationY>
        <defaultConnector>
            <targetReference>Block_Invalid_Order</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Invalid</defaultConnectorLabel>
        <rules>
            <name>Is_Valid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Prepare_Order.isSuccess</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Approval_Threshold</targetReference>
            </connector>
            <label>Valid</label>
        </rules>
    </decisions>
    <decisions>
        <name>Threshold_Found</name>
        <label>Threshold Found?</label>
        <locationX>1076</locationX>
        <locationY>300</locationY>
        <defaultConnector>
            <targetReference>Block_No_Threshold</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>None Configured</defaultConnectorLabel>
        <rules>
            <name>Has_Threshold</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Approval_Threshold</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Submit_For_Approval</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Queue_Found</name>
        <label>Notification Queue Found?</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Has_Queue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Notification_Queue</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Notify_Approvers</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <formulas>
        <name>frmSubmitTitle</name>
        <dataType>String</dataType>
        <expression>"Purchase order awaiting approval: " &amp; {!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>frmSubmitMessage</name>
        <dataType>String</dataType>
        <expression>"Purchase order " &amp; {!$Record.Name} &amp; " for " &amp; TEXT({!Prepare_Order.totalAmount}) &amp; " needs approval (approval level " &amp; TEXT({!Get_Approval_Threshold.Approval_Level__c}) &amp; ")."</expression>
    </formulas>
    <formulas>
        <name>frmApprovedMessage</name>
        <dataType>String</dataType>
        <expression>"Purchase order " &amp; {!$Record.Name} &amp; " was approved and can now be dispatched to the supplier."</expression>
    </formulas>
    <formulas>
        <name>frmReturnedMessage</name>
        <dataType>String</dataType>
        <expression>"Purchase order " &amp; {!$Record.Name} &amp; " was rejected or recalled and returned to Draft. Check the approval history, correct the order and resubmit it."</expression>
    </formulas>
    <recordLookups>
        <name>Get_Approval_Threshold</name>
        <description>Highest band whose minimum is not above the order total. Band amounts are configured in Custom Metadata.</description>
        <label>Get Approval Threshold</label>
        <locationX>476</locationX>
        <locationY>300</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Threshold_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Block_Threshold_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Min_Amount__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>Prepare_Order.totalAmount</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Approval_Threshold__mdt</object>
        <sortField>Min_Amount__c</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Notification_Queue</name>
        <label>Get Notification Queue</label>
        <locationX>1076</locationX>
        <locationY>450</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Queue_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Capture_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Approval_Threshold.Notification_Queue__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <subflows>
        <name>Notify_Approvers</name>
        <label>Notify Approvers</label>
        <locationX>476</locationX>
        <locationY>600</locationY>
        <flowName>Procurement_Subflow_Notify</flowName>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>recipientId</name>
            <value>
                <elementReference>Get_Notification_Queue.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>title</name>
            <value>
                <elementReference>frmSubmitTitle</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>message</name>
            <value>
                <elementReference>frmSubmitMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>createTask</name>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>Notify_Buyer_Approved</name>
        <label>Notify Buyer - Approved</label>
        <locationX>1076</locationX>
        <locationY>600</locationY>
        <flowName>Procurement_Subflow_Notify</flowName>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>recipientId</name>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>title</name>
            <value>
                <stringValue>Purchase order approved</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>message</name>
            <value>
                <elementReference>frmApprovedMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>createTask</name>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>Notify_Buyer_Returned</name>
        <label>Notify Buyer - Returned</label>
        <locationX>176</locationX>
        <locationY>750</locationY>
        <flowName>Procurement_Subflow_Notify</flowName>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>recipientId</name>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>title</name>
            <value>
                <stringValue>Purchase order returned to Draft</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>message</name>
            <value>
                <elementReference>frmReturnedMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>createTask</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>taskDueInDays</name>
            <value>
                <numberValue>3.0</numberValue>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <name>faultMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Route_By_Status</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3 OR 4)</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending Approval</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Draft</stringValue>
            </value>
        </filters>
        <object>Purchase_Order__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
