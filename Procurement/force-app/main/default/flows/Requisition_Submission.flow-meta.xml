<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>After-save flow that runs when a requisition moves to Submitted. Validates the requisition and its lines in RequisitionService, blocks the change with a clear message when invalid, stamps the submission fields and authoritative total, starts the Requisition_Approval process and notifies the Procurement Approvers queue.</description>
    <environments>Default</environments>
    <interviewLabel>Requisition Submission {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Requisition Submission</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <actionCalls>
        <name>Validate_Requisition</name>
        <description>Checks lines, quantities and prices, and returns the authoritative estimated total.</description>
        <label>Validate Requisition</label>
        <locationX>176</locationX>
        <locationY>150</locationY>
        <actionName>RequisitionService</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Is_Valid</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Block_On_Fault</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>requisitionId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <actionCalls>
        <name>Submit_For_Approval</name>
        <label>Submit For Approval</label>
        <locationX>776</locationX>
        <locationY>300</locationY>
        <actionName>submit</actionName>
        <actionType>submit</actionType>
        <connector>
            <targetReference>Get_Approvers_Queue</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Block_Approval_Fault</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>objectId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>processDefinitionNameOrId</name>
            <value>
                <stringValue>Requisition_Approval</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>skipEntryCriteria</name>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputParameters>
    </actionCalls>
    <assignments>
        <name>Capture_Fault</name>
        <description>Approver notification is best-effort; the approval request itself was already created.</description>
        <label>Capture Fault</label>
        <locationX>1076</locationX>
        <locationY>450</locationY>
        <assignmentItems>
            <assignToReference>faultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <customErrors>
        <name>Block_Invalid_Requisition</name>
        <label>Block Invalid Requisition</label>
        <locationX>776</locationX>
        <locationY>150</locationY>
        <customErrorMessages>
            <errorMessage>{!Validate_Requisition.message}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Block_On_Fault</name>
        <label>Block On Fault</label>
        <locationX>1076</locationX>
        <locationY>150</locationY>
        <customErrorMessages>
            <errorMessage>The requisition could not be validated: {!$Flow.FaultMessage}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Block_Update_Fault</name>
        <label>Block Update Fault</label>
        <locationX>476</locationX>
        <locationY>300</locationY>
        <customErrorMessages>
            <errorMessage>The requisition could not be updated: {!$Flow.FaultMessage}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Block_Approval_Fault</name>
        <label>Block Approval Fault</label>
        <locationX>1076</locationX>
        <locationY>300</locationY>
        <customErrorMessages>
            <errorMessage>Approval could not be started: {!$Flow.FaultMessage}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Is_Valid</name>
        <label>Requisition Valid?</label>
        <locationX>476</locationX>
        <locationY>150</locationY>
        <defaultConnector>
            <targetReference>Block_Invalid_Requisition</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Invalid</defaultConnectorLabel>
        <rules>
            <name>Valid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Validate_Requisition.isValid</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Submission_Fields</targetReference>
            </connector>
            <label>Valid</label>
        </rules>
    </decisions>
    <decisions>
        <name>Queue_Found</name>
        <label>Approvers Queue Found?</label>
        <locationX>476</locationX>
        <locationY>450</locationY>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Has_Queue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Approvers_Queue</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Notify_Approvers</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <formulas>
        <name>frmNotifyTitle</name>
        <dataType>String</dataType>
        <expression>"Requisition awaiting approval: " &amp; {!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>frmNotifyMessage</name>
        <dataType>String</dataType>
        <expression>"Requisition " &amp; {!$Record.Name} &amp; " (" &amp; TEXT({!Validate_Requisition.estimatedTotal}) &amp; ") was submitted and needs your review."</expression>
    </formulas>
    <recordLookups>
        <name>Get_Approvers_Queue</name>
        <label>Get Approvers Queue</label>
        <locationX>176</locationX>
        <locationY>450</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Queue_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Capture_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Procurement_Approvers</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Submission_Fields</name>
        <description>Must run before the approval submission, which locks the record.</description>
        <label>Update Submission Fields</label>
        <locationX>176</locationX>
        <locationY>300</locationY>
        <connector>
            <targetReference>Submit_For_Approval</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Block_Update_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Estimated_Total__c</field>
            <value>
                <elementReference>Validate_Requisition.estimatedTotal</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Submitted_At__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Approval_Required__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Purchase_Requisition__c</object>
    </recordUpdates>
    <subflows>
        <name>Notify_Approvers</name>
        <label>Notify Approvers</label>
        <locationX>776</locationX>
        <locationY>450</locationY>
        <flowName>Procurement_Subflow_Notify</flowName>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>recipientId</name>
            <value>
                <elementReference>Get_Approvers_Queue.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>title</name>
            <value>
                <elementReference>frmNotifyTitle</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>message</name>
            <value>
                <elementReference>frmNotifyMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>createTask</name>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <name>faultMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Validate_Requisition</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Submitted</stringValue>
            </value>
        </filters>
        <object>Purchase_Requisition__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
