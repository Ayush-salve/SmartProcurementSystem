    <decisions>
        <name>Check_Receipt</name>
        <label>Check Receipt</label>
        <locationX>476</locationX>
        <locationY>150</locationY>
        <defaultConnector>
            <targetReference>Get_Receipt_Line</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Receipt Can Be Posted</defaultConnectorLabel>
        <rules>
            <name>Receipt_Not_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Receipt</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Not_Found</targetReference>
            </connector>
            <label>Receipt Not Found</label>
        </rules>
        <rules>
            <name>Already_Posted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Receipt.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Posted</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Already_Posted</targetReference>
            </connector>
            <label>Already Posted</label>
        </rules>
        <rules>
            <name>Receipt_Rejected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Receipt.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Rejected</targetReference>
            </connector>
            <label>Receipt Rejected</label>
        </rules>
        <rules>
            <name>Missing_Purchase_Order</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Receipt.Purchase_Order__c</leftValueReference>
                <operator>IsNull</operator>
