<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>After-save flow that dispatches an approved purchase order to the supplier. Runs when a dispatch is requested (Last_Sync_Status = Pending) on an Approved order that has not been dispatched. PurchaseOrderService validates approval, supplier and lines and queues ProcurementDispatchQueueable, which performs the callout asynchronously through the named credential and marks the order Sent only after the supplier confirms it. If validation fails here the dispatch is marked Failed, the order stays Approved and the buyer is notified.</description>
    <environments>Default</environments>
    <interviewLabel>Purchase Order Dispatch {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Purchase Order Dispatch</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <actionCalls>
        <name>Validate_And_Queue_Dispatch</name>
        <description>Validates the order and enqueues the asynchronous dispatch callout.</description>
        <label>Validate And Queue Dispatch</label>
        <locationX>176</locationX>
        <locationY>150</locationY>
        <actionName>PurchaseOrderService</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Dispatch_Queued</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Fault_Message</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>purchaseOrderId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>operation</name>
            <value>
                <stringValue>DISPATCH</stringValue>
            </value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <assignments>
        <name>Set_Validation_Message</name>
        <label>Set Validation Message</label>
        <locationX>776</locationX>
        <locationY>150</locationY>
        <assignmentItems>
            <assignToReference>varFailureMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Validate_And_Queue_Dispatch.message</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Return_To_Approved</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Fault_Message</name>
        <label>Set Fault Message</label>
        <locationX>1076</locationX>
        <locationY>150</locationY>
        <assignmentItems>
            <assignToReference>varFailureMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Return_To_Approved</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Dispatch_Queued</name>
        <label>Dispatch Queued?</label>
        <locationX>476</locationX>
        <locationY>150</locationY>
        <defaultConnector>
            <targetReference>Set_Validation_Message</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Validation Failed</defaultConnectorLabel>
        <rules>
            <name>Queued</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Validate_And_Queue_Dispatch.isSuccess</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Queued</label>
        </rules>
    </decisions>
    <formulas>
        <name>frmFailureTitle</name>
        <dataType>String</dataType>
        <expression>"Purchase order dispatch failed: " &amp; {!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>frmFailureMessage</name>
        <dataType>String</dataType>
        <expression>"Purchase order " &amp; {!$Record.Name} &amp; " could not be dispatched: " &amp; {!varFailureMessage} &amp; " It is still Approved."</expression>
    </formulas>
    <formulas>
        <name>frmStoredError</name>
        <dataType>String</dataType>
        <expression>LEFT({!varFailureMessage}, 255)</expression>
    </formulas>
    <recordUpdates>
        <name>Return_To_Approved</name>
        <description>Marks the requested dispatch as Failed and records the reason. The order stays Approved and the flow criteria (Pending) are no longer met, so it does not re-trigger.</description>
        <label>Mark Dispatch Failed</label>
        <locationX>176</locationX>
        <locationY>300</locationY>
        <connector>
            <targetReference>Notify_Buyer</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Notify_Buyer</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Last_Sync_Status__c</field>
            <value>
                <stringValue>Failed</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Last_Sync_Error__c</field>
            <value>
                <elementReference>frmStoredError</elementReference>
            </value>
        </inputAssignments>
        <object>Purchase_Order__c</object>
    </recordUpdates>
    <subflows>
        <name>Notify_Buyer</name>
        <label>Notify Buyer</label>
        <locationX>476</locationX>
        <locationY>300</locationY>
        <flowName>Procurement_Subflow_Notify</flowName>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>recipientId</name>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>title</name>
            <value>
                <elementReference>frmFailureTitle</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>message</name>
            <value>
                <elementReference>frmFailureMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>createTask</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>taskDueInDays</name>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <name>varFailureMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Validate_And_Queue_Dispatch</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Last_Sync_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <filters>
            <field>External_Order_Id__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Purchase_Order__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
