<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>Screen flow for warehouse users. Step 1 selects a receivable purchase order; step 2 embeds the existing goodsReceiptForm LWC (quantities, rejection reasons, validation, receipt and line creation); the flow then posts the saved receipt through Goods_Receipt_Posting so stock, transactions and PO status are updated atomically.</description>
    <environments>Default</environments>
    <interviewLabel>Goods Receipt Submission {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Goods Receipt Submission</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <decisions>
        <name>Receipt_Saved</name>
        <label>Receipt Saved?</label>
        <locationX>776</locationX>
        <locationY>150</locationY>
        <defaultConnector>
            <targetReference>Receipt_Not_Saved</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Saved</defaultConnectorLabel>
        <rules>
            <name>Has_Receipt</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varReceiptId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Post_Receipt</targetReference>
            </connector>
            <label>Saved</label>
        </rules>
    </decisions>
    <decisions>
        <name>Posted_OK</name>
        <label>Posted Successfully?</label>
        <locationX>176</locationX>
        <locationY>300</locationY>
        <defaultConnector>
            <targetReference>Failure_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Failure</defaultConnectorLabel>
        <rules>
            <name>Success</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varPostSuccess</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Success_Screen</targetReference>
            </connector>
            <label>Success</label>
        </rules>
    </decisions>
    <dynamicChoiceSets>
        <name>rcsReceivablePOs</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Sent</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Acknowledged</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Partially Received</stringValue>
            </value>
        </filters>
        <object>Purchase_Order__c</object>
        <sortField>Name</sortField>
        <sortOrder>Desc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <screens>
        <name>Select_Purchase_Order</name>
        <label>Select Purchase Order</label>
        <locationX>176</locationX>
        <locationY>150</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Enter_Receipt</targetReference>
        </connector>
        <fields>
            <name>Purchase_Order_Dropdown</name>
            <choiceReferences>rcsReceivablePOs</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Purchase Order</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Enter_Receipt</name>
        <label>Enter Receipt Quantities</label>
        <locationX>476</locationX>
        <locationY>150</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Receipt_Saved</targetReference>
        </connector>
        <fields>
            <name>Receipt_Form</name>
            <extensionName>c:goodsReceiptForm</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>recordId</name>
                <value>
                    <elementReference>Purchase_Order_Dropdown</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>postingHandledByFlow</name>
                <value>
                    <booleanValue>true</booleanValue>
                </value>
            </inputParameters>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <outputParameters>
                <assignToReference>varReceiptId</assignToReference>
                <name>receiptId</name>
            </outputParameters>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Success_Screen</name>
        <label>Receipt Posted</label>
        <locationX>476</locationX>
        <locationY>300</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Success_Text</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Goods receipt posted.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Stock, inventory transactions and the purchase order were updated. Purchase order status: {!varPoStatus}.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Failure_Screen</name>
        <label>Receipt Could Not Be Posted</label>
        <locationX>776</locationX>
        <locationY>300</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Failure_Text</name>
            <fieldText>&lt;p&gt;&lt;b&gt;The receipt was saved but could not be posted.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;{!varPostMessage}&lt;/p&gt;&lt;p&gt;No stock was changed. Correct the issue and post the receipt again from the Goods Receipt record.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Receipt_Not_Saved</name>
        <label>Receipt Not Saved</label>
        <locationX>1076</locationX>
        <locationY>300</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Not_Saved_Text</name>
            <fieldText>&lt;p&gt;The receipt was not saved, so nothing was posted. Go back and try again.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <subflows>
        <name>Post_Receipt</name>
        <label>Post Receipt</label>
        <locationX>1076</locationX>
        <locationY>150</locationY>
        <connector>
            <targetReference>Posted_OK</targetReference>
        </connector>
        <flowName>Goods_Receipt_Posting</flowName>
        <inputAssignments>
            <name>receiptId</name>
            <value>
                <elementReference>varReceiptId</elementReference>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>varPostSuccess</assignToReference>
            <name>isSuccess</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varPostMessage</assignToReference>
            <name>resultMessage</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varPoStatus</assignToReference>
            <name>purchaseOrderStatus</name>
        </outputAssignments>
    </subflows>
    <variables>
        <name>varReceiptId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varPostSuccess</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varPostMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varPoStatus</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Select_Purchase_Order</targetReference>
        </connector>
    </start>
    <status>Active</status>
</Flow>
