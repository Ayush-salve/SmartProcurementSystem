<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Non_Negative_Quantity_Rejected</fullName>
    <active>true</active>
    <description>Prevents saving a Goods Receipt Line with a negative Quantity Rejected.</description>
    <errorConditionFormula>Quantity_Rejected__c &lt; 0</errorConditionFormula>
    <errorMessage>Quantity Rejected cannot be negative.</errorMessage>
    <errorDisplayField>Quantity_Rejected__c</errorDisplayField>
</ValidationRule>
