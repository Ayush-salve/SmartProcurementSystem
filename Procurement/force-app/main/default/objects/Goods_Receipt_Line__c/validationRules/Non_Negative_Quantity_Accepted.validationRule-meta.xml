<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Non_Negative_Quantity_Accepted</fullName>
    <active>true</active>
    <description>Prevents saving a Goods Receipt Line with a negative Quantity Accepted.</description>
    <errorConditionFormula>Quantity_Accepted__c &lt; 0</errorConditionFormula>
    <errorMessage>Quantity Accepted cannot be negative.</errorMessage>
    <errorDisplayField>Quantity_Accepted__c</errorDisplayField>
</ValidationRule>
