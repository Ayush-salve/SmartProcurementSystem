<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Non_Negative_Qty_Received</fullName>
    <active>true</active>
    <description>Quantity Received cannot be negative on a Purchase Order Line.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Quantity_Received__c)), Quantity_Received__c &lt; 0)</errorConditionFormula>
    <errorMessage>Quantity Received cannot be negative.</errorMessage>
    <errorDisplayField>Quantity_Received__c</errorDisplayField>
</ValidationRule>
