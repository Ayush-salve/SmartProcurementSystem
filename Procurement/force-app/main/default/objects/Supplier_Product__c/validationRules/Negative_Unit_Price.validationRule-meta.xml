<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Negative_Unit_Price</fullName>
    <active>true</active>
    <description>Prevents saving a Supplier Product record with a negative Unit Price.</description>
    <errorConditionFormula>Unit_Price__c &lt; 0</errorConditionFormula>
    <errorMessage>Unit Price cannot be negative.</errorMessage>
</ValidationRule>
