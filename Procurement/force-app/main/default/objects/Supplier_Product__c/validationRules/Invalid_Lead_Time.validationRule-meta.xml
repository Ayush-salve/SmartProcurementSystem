<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Invalid_Lead_Time</fullName>
    <active>true</active>
    <description>Prevents saving a Supplier Product record with a negative Lead Time.</description>
    <errorConditionFormula>Lead_Time_Days__c &lt; 0</errorConditionFormula>
    <errorMessage>Lead Time (Days) cannot be negative.</errorMessage>
</ValidationRule>
