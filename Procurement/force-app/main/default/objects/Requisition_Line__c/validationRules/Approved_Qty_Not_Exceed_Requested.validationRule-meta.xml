<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Approved_Qty_Not_Exceed_Requested</fullName>
    <active>true</active>
    <description>Approved Quantity cannot exceed Requested Quantity on a Requisition Line.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Approved_Qty__c)), NOT(ISBLANK(Requested_Qty__c)), Approved_Qty__c &gt; Requested_Qty__c)</errorConditionFormula>
    <errorMessage>Approved Quantity cannot exceed Requested Quantity.</errorMessage>
    <errorDisplayField>Approved_Qty__c</errorDisplayField>
</ValidationRule>
