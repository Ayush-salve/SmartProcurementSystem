<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Non_Negative_Reorder_Point</fullName>
    <active>true</active>
    <description>Prevents saving an Inventory record with a negative Reorder Point.</description>
    <errorConditionFormula>Reorder_Point__c &lt; 0</errorConditionFormula>
    <errorMessage>Reorder Point cannot be negative.</errorMessage>
    <errorDisplayField>Reorder_Point__c</errorDisplayField>
</ValidationRule>
